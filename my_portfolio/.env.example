# Supabase
# Get these from your project: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Contact form notifications (server-side — set in Vercel Environment Variables too)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password
WHATSAPP_PHONE=923XXXXXXXXX
CALLMEBOT_API_KEY=your_callmebot_key
